# Supply these to the harness process, never to coding sandboxes.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TFVN_CLOUD_TOKEN=
# Local control-plane development only:
DATABASE_URL=postgres://tfvn:local-development-only@localhost:5432/tfvn
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TFVN_WORKER_ROOT=/tmp/tfvn-cloud/runs
TFVN_ARTIFACT_DIR=/tmp/tfvn-cloud/artifacts
