{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "jsx": "react-jsx", "resolveJsonModule": true,
    "declaration": true, "sourceMap": true, "rootDir": ".", "outDir": "dist"
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts"]
}
